# Vanguard local Docker Compose environment.
# Copy to .env before running `docker compose`.

# --- Runtime profile --------------------------------------------------------
LOG_LEVEL=INFO

# --- Service ports ----------------------------------------------------------
# Kong is the only published application ingress.
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
MODELS_HOST=0.0.0.0
MODELS_PORT=8090

# --- Oracle 26ai convergence (single backing store) -------------------------
# Local dev uses the oracle-free container. Point these at Autonomous DB for OCI.
# Host port 1522 avoids clashing with another local Oracle on 1521; containers
# always reach it at oracle:1521 internally.
ORACLE_PORT=1522
ORACLE_PWD=replace_with_local_password
# Admin (SYS/SYSTEM) creds used only by the bootstrap step to provision the app
# user. The app itself connects as the non-privileged MC user below.
ORACLE_ADMIN_USER=SYSTEM
ORACLE_ADMIN_PASSWORD=replace_with_local_password
# Application user (created in the ASSM USERS tablespace so JSON columns work).
MC_DATABASE__USER=MC
MC_DATABASE__PASSWORD=replace_with_local_password
MC_DATABASE__DSN=oracle:1521/FREEPDB1

# --- Dataset auto-loading (dataloader compose job) --------------------------
# Datasets imported automatically on `up` (idempotent). Comma list; empty = none.
LOAD_DATASETS=primekg,multihop
# Verified direct-download sources. PrimeKG kg.csv = Harvard Dataverse datafile
# 6180620 (~1 GB). MultiHop corpus.json is Git LFS, so it MUST use the LFS
# media.githubusercontent.com URL (the raw URL returns a 132-byte pointer).
DATASET_PRIMEKG_URL=https://dataverse.harvard.edu/api/access/datafile/6180620
DATASET_MULTIHOP_URL=https://media.githubusercontent.com/media/yixuantt/MultiHop-RAG/main/dataset/corpus.json
# Optional agent-model overrides. Leave unset to use config/agent-worker/config.yaml.
# MC_MODELS__ORCHESTRATOR__PROVIDER=oci_generative_ai
# MC_MODELS__ORCHESTRATOR__MODEL_ID=xai.grok-4.3
# MC_MODELS__ORCHESTRATOR__CONFIG_FILE=/root/.oci/config
# A public semantic prompt-injection classifier runs in the firewall container.
# Ollama reviews only uncertain scores when explicitly enabled. YAML defaults
# live in config/firewall/config.yaml; these optional environment values win.
MC_SECURITY__PROMPT_GUARD_ENABLED=true
MC_SECURITY__PROMPT_GUARD_MODEL_ID=patronus-studio/wolf-defender-prompt-injection-small
MC_SECURITY__PROMPT_GUARD_THRESHOLD=0.50
MC_SECURITY__PROMPT_GUARD_MAX_LENGTH=512
MC_SECURITY__OLLAMA_ESCALATION_ENABLED=false
MC_SECURITY__OLLAMA_ESCALATION_LOWER_THRESHOLD=0.35
MC_SECURITY__OLLAMA_ESCALATION_UPPER_THRESHOLD=0.65
