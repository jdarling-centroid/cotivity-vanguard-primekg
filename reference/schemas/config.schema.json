{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medical-classifier.example/schemas/config.schema.json",
  "title": "Medical Classifier POC Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["models", "thresholds", "retrieval", "workers"],
  "properties": {
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ocr",
        "vision",
        "page_classification",
        "document_classification",
        "metadata_extraction",
        "embedding"
      ],
      "properties": {
        "ocr": {"$ref": "#/$defs/modelEndpoint"},
        "vision": {"$ref": "#/$defs/modelEndpoint"},
        "page_classification": {"$ref": "#/$defs/modelEndpoint"},
        "document_classification": {"$ref": "#/$defs/modelEndpoint"},
        "metadata_extraction": {"$ref": "#/$defs/modelEndpoint"},
        "embedding": {"$ref": "#/$defs/modelEndpoint"}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accept_label",
        "low_confidence",
        "document_boundary",
        "minimum_search_score"
      ],
      "properties": {
        "accept_label": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.7},
        "low_confidence": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5},
        "document_boundary": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.75},
        "minimum_search_score": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.2}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_limit", "maximum_limit", "inline_text_bytes", "artifact_url_ttl_seconds"],
      "properties": {
        "default_limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20},
        "maximum_limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100},
        "inline_text_bytes": {"type": "integer", "minimum": 1024, "default": 65536},
        "artifact_url_ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 86400, "default": 900},
        "rank_weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "semantic": {"type": "number", "minimum": 0, "default": 1},
            "lexical": {"type": "number", "minimum": 0, "default": 1},
            "structured": {"type": "number", "minimum": 0, "default": 1},
            "graph": {"type": "number", "minimum": 0, "default": 1}
          }
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_concurrency", "stage_timeout_seconds"],
      "properties": {
        "page_concurrency": {"type": "integer", "minimum": 1, "default": 8},
        "stage_timeout_seconds": {"type": "integer", "minimum": 30, "default": 900}
      }
    }
  },
  "$defs": {
    "modelEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_id", "version"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["oci_document_understanding", "oci_vision", "oci_generative_ai", "custom", "external"]
        },
        "model_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "format": "uri"},
        "prompt_version": {"type": "string"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "default": 120}
      }
    }
  }
}

